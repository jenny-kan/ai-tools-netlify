# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets only — the annotated example ships with the repo)
# (final rules live in the "secrets & data" section below)

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# ------------------------------------------------------------- secrets & data
# Never commit runtime data or secrets: the Postgres URL in .env holds
# deployment credentials; stray *.db files (e.g. import test fixtures)
# stay local.
*.db
*.db-journal
.env*
!.env.example

# Generated download packages (served from public/ but never committed)
public/downloads/

# Sandbox / agent artifacts (not part of the product)
/tool-results/
/agent-ctx/
/download/
/examples/
/mini-services/
/upload/
/tests/

# prisma generated client (Prisma 7 generates into src/, not node_modules)
node_modules/.prisma
src/generated/

# Skills directory
/skills/